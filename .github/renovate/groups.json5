{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Rook-Ceph operator, cluster chart, and Ceph container image",
      groupName: "Rook Ceph",
      matchPackageNames: [
        "ghcr.io/rook/rook-ceph",
        "ghcr.io/rook/rook-ceph-cluster",
        "quay.io/ceph/ceph"
      ],
      matchDatasources: ["docker", "helm", "oci"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      },
    },
    {
      description: "Traefik chart and CRD",
      groupName: "Traefik",
      matchPackageNames: ["traefik", "traefik-crd-source"],
      matchDatasources: ["helm", "regex", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      },
    },
    {
      description: "Cilium CNI, CLI tools, and Hubble",
      groupName: "Cilium",
      matchPackageNames: [
        "quay.io/cilium/cilium",
        "quay.io/cilium/operator-generic",
        "cilium",
        "cilium/cilium-cli",
        "cilium/hubble"
      ],
      matchDatasources: ["helm", "docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      },
    },
    {
      description: "Victoria Metrics components",
      groupName: "Victoria Metrics",
      matchPackageNames: [
        "victoria-metrics",
        "victoriametrics",
        "ghcr.io/victoriametrics/helm-charts"
      ],
      matchDatasources: ["helm", "docker", "oci"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      },
    },
    {
      description: "External Secrets Operator",
      groupName: "External Secrets",
      matchPackageNames: ["external-secrets"],
      matchDatasources: ["helm"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      },
    },
    {
      description: "CloudNativePG components",
      groupName: "CloudNativePG",
      matchPackageNames: ["cloudnative-pg", "cnpg"],
      matchDatasources: ["helm", "docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      },
    },
    {
      description: "Flux components",
      groupName: "Flux",
      matchPackageNames: ["fluxcd/*", "ghcr.io/fluxcd/*", "ghcr.io/controlplaneio-fluxcd/**"],
      matchDatasources: ["docker", "helm", "github-releases", "oci"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      },
    },
    {
      description: "Authentik stack",
      groupName: "Authentik",
      matchPackageNames: ["goauthentik/*", "ghcr.io/goauthentik/*"],
      matchDatasources: ["docker", "helm"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      },
    },
    {
      description: "Cert-Manager components",
      groupName: "Cert-Manager",
      matchPackageNames: ["cert-manager", "jetstack/cert-manager"],
      matchDatasources: ["helm", "docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      },
    },
    {
      description: "External-DNS components",
      groupName: "External-DNS",
      matchPackageNames: ["external-dns", "kubernetes-sigs/external-dns"],
      matchDatasources: ["helm", "docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      },
    },
    {
      description: "Snapshot Controller components (image and CRD source share a tag)",
      groupName: "Snapshot Controller",
      matchPackageNames: [
        "snapshot-controller",
        "registry.k8s.io/sig-storage/snapshot-controller",
        "registry.k8s.io/sig-storage/csi-snapshotter",
        "kubernetes-csi/external-snapshotter"
      ],
      matchDatasources: ["helm", "docker", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      },
    },
    {
      description: "CSI Addons controller and CRD source (share a tag)",
      groupName: "CSI Addons",
      matchPackageNames: [
        "quay.io/csiaddons/k8s-controller",
        "quay.io/csiaddons/k8s-sidecar",
        "csi-addons/kubernetes-csi-addons"
      ],
      matchDatasources: ["docker", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      },
    },
    {
      description: "Vertical Pod Autoscaler chart and Talos CRD seed (versions differ, grouped for visibility)",
      groupName: "Vertical Pod Autoscaler",
      matchPackageNames: ["vertical-pod-autoscaler", "kubernetes/autoscaler"],
      matchDatasources: ["helm", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      }
    },
    {
      description: "BJW-S App Template",
      groupName: "App Template",
      matchPackageNames: ["ghcr.io/bjw-s-labs/helm/app-template"],
      matchDatasources: ["helm"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      }
    },
    {
      // Same rolling-branch reasoning as the Talos and Kubernetes groups below:
      // a versioned branchTopic splits the group whenever the two images are
      // momentarily offered different versions.
      description: "n8n app and runner images (versions must match)",
      groupName: "n8n",
      matchPackageNames: ["n8nio/**"],
      matchDatasources: ["docker", "custom.n8n-stable"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}"
      }
    },
    {
      // The feature image and the gh release it installs are separate packages,
      // so a split would ship a feature version mismatched with its gh binary.
      description: "GitHub CLI devcontainer feature and the gh release it installs",
      groupName: "github-cli",
      matchPackageNames: ["ghcr.io/devcontainers/features/github-cli", "cli/cli"],
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "GitHub CLI (feature + gh)"
      }
    },
    {
      // Both images ship the same upstream curl release to the same app, so a
      // split would let the two pins drift apart.
      // Ref anthony-spruyt/spruyt-labs#2786
      description: "curl images (same upstream release via two registries)",
      groupName: "curl",
      matchPackageNames: ["alpine/curl", "docker.io/curlimages/curl"],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group"
      }
    },
    {
      description: "Go toolchain (go.mod directive + Dockerfile builder image stay in sync)",
      groupName: "Go toolchain",
      matchPackageNames: ["golang", "go"],
      matchDatasources: ["docker", "golang-version"],
      group: {
        commitMessageTopic: "{{{groupName}}}",
        branchTopic: "{{{groupName}}}-{{{newVersion}}}"
      }
    },
    {
      // Members render newVersion differently (github-releases "1.14.0", docker
      // and go "v1.14.0") and the docker tag often lags the GitHub release, so
      // a versioned branchTopic fans one upgrade out into several PRs. Omit it
      // here: one rolling branch collects whatever the members currently offer.
      description: "Talos OS (release, installer image, machinery Go client)",
      groupName: "Talos",
      matchPackageNames: [
        "siderolabs/talos",
        "ghcr.io/siderolabs/installer",
        "github.com/siderolabs/talos/pkg/machinery"
      ],
      matchDatasources: ["docker", "github-releases", "go"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}"
      }
    },
    {
      // Same rolling-branch reasoning as the Talos group above.
      description: "Kubernetes (core version, kubelet, kubectl sidecars, Go client libs)",
      groupName: "Kubernetes",
      matchPackageNames: [
        "kubernetes",
        "kubernetes/kubernetes",
        "ghcr.io/siderolabs/kubelet",
        "bitnami/kubectl",
        "public.ecr.aws/bitnami/kubectl",
        "alpine/k8s",
        "k8s.io/api",
        "k8s.io/apimachinery",
        "k8s.io/client-go"
      ],
      matchDatasources: ["docker", "github-releases", "go"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
        branchTopic: "{{{groupName}}}"
      }
    }
  ]
}
