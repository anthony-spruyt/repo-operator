{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    // ============ Supply-chain default ============
    {
      description: "Default minimum release age for supply-chain safety (overridden per-package below)",
      matchUpdateTypes: ["major", "minor", "patch"],
      minimumReleaseAge: "7 days"
    },

    // ============ Own packages ============
    // Split per datasource so each name only matches on the registry that owns it.
    {
      description: "Own container images: no release age wait, any-time schedule",
      matchPackageNames: ["ghcr.io/anthony-spruyt/**", "docker.io/aspruyt/**", "aspruyt/**"],
      matchDatasources: ["docker"],
      minimumReleaseAge: "0 days",
      schedule: ["at any time"]
    },
    {
      description: "Own GitHub actions and releases: no release age wait, any-time schedule",
      matchPackageNames: ["anthony-spruyt/**"],
      matchDatasources: ["github-tags", "github-releases", "github-digest"],
      minimumReleaseAge: "0 days",
      schedule: ["at any time"]
    },
    {
      description: "Own npm packages: no release age wait, any-time schedule",
      matchPackageNames: ["@aspruyt/**"],
      matchDatasources: ["npm"],
      minimumReleaseAge: "0 days",
      schedule: ["at any time"]
    },

    // ============ Own MegaLinter flavor images ============
    // Changelogs live per image directory in container-images, not at its root.
    {
      description: "Release notes for own images: megalinter-base",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/anthony-spruyt/megalinter-base"],
      sourceDirectory: "megalinter-base"
    },
    {
      description: "Release notes for own images: megalinter-cpp",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/anthony-spruyt/megalinter-cpp"],
      sourceDirectory: "megalinter-cpp"
    },
    {
      description: "Release notes for own images: megalinter-go",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/anthony-spruyt/megalinter-go"],
      sourceDirectory: "megalinter-go"
    },
    {
      description: "Release notes for own images: megalinter-python",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/anthony-spruyt/megalinter-python"],
      sourceDirectory: "megalinter-python"
    },
    {
      description: "Release notes for own images: megalinter-spruyt-labs",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/anthony-spruyt/megalinter-spruyt-labs"],
      sourceDirectory: "megalinter-spruyt-labs"
    },
    {
      description: "Release notes for own images: megalinter-typescript",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/anthony-spruyt/megalinter-typescript"],
      sourceDirectory: "megalinter-typescript"
    },

    // ============ Claude CLI ============
    {
      description: "Claude CLI: no release age wait (first-party tooling)",
      matchPackageNames: ["@anthropic-ai/claude-code"],
      minimumReleaseAge: "0 days"
    },

    // ============ High-frequency packages ============
    {
      description: "Limit renovate CLI updates to weekly (releases multiple times daily)",
      matchPackageNames: ["renovate"],
      matchDatasources: ["npm", "docker"],
      schedule: ["before 9am on monday"],
      labels: ["renovate/renovate-cli"],
      groupName: "renovate-cli",
      group: {
        commitMessageTopic: "Renovate CLI"
      }
    },

    // ============ Mainline / prerelease guards ============
    {
      // The helm datasource sees every published chart, mainline included, and
      // ranks e.g. 2.36.1 above the stable 2.35.6 pin. The annotated custom.regex
      // manager owns the version instead, backed by custom.coder-stable.
      // Ref anthony-spruyt/spruyt-labs#2640
      description: "Disable flux manager for the Coder chart (version tracked via the coder-stable custom datasource)",
      matchManagers: ["flux"],
      matchPackageNames: ["coder"],
      matchDatasources: ["helm"],
      enabled: false
    },

    // ============ Devcontainer base image (managed via xfg sync) ============
    {
      description: "Disable devcontainer updates in all repos except repo-operator (xfg syncs the devcontainer config)",
      matchManagers: ["devcontainer"],
      matchRepositories: ["!/anthony-spruyt/repo-operator/"],
      enabled: false
    },

    // ============ repo-operator shared CI pins ============
    {
      // Every merge moves main: without updateNotScheduled, open PRs re-push (and lose approvals) on each merge.
      description: "repo-operator workflows and actions: callers pin a main commit with a '# main' comment; bump them monthly in one PR",
      matchPackageNames: ["anthony-spruyt/repo-operator"],
      matchManagers: ["github-actions"],
      groupName: "repo-operator shared CI",
      schedule: ["before 9am on the first day of the month"],
      updateNotScheduled: false
    },

    // ============ Docker/OCI ============
    {
      matchDatasources: ["docker", "oci"],
      enabled: true,
      commitMessageTopic: "container image {{depName}}",
      commitMessageExtra: "to {{#if isSingleVersion}}v{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}",
      pinDigests: true
    },
    {
      matchDatasources: ["docker", "oci"],
      matchUpdateTypes: ["major"],
      labels: ["renovate/image", "dep/major"]
    },
    {
      matchDatasources: ["docker", "oci"],
      matchUpdateTypes: ["minor"],
      labels: ["renovate/image", "dep/minor"]
    },
    {
      // Must stay after the blanket "enabled: true" above, which would
      // otherwise re-enable these. n8n tags beta builds with plain semver, so
      // the docker datasource ranks them above stable; custom.n8n-stable
      // resolves the stable tag and the annotated pins own these instead.
      // Leaving the built-in managers on re-offers the prerelease as a second
      // dep on the same line, which Renovate drops as an upgrade collision.
      description: "Disable built-in managers for n8n images (version tracked via the n8n-stable custom datasource)",
      matchPackageNames: ["n8nio/**"],
      matchDatasources: ["docker"],
      enabled: false
    },
    {
      // Must stay after the blanket "enabled: true" above: re-enabled, it pins a
      // digest onto golang:<version>, absent from Dockerfiles that use
      // ${GO_VERSION}, so the branch commits nothing and never opens a PR.
      // Ref anthony-spruyt/spruyt-labs#3086
      description: "Disable dockerfile manager for golang (ARG interpolation breaks updates; custom.regex manager handles these via annotations)",
      matchManagers: ["dockerfile"],
      matchPackageNames: ["golang"],
      enabled: false
    },
    {
      matchDatasources: ["docker", "oci"],
      matchUpdateTypes: ["patch"],
      labels: ["renovate/image", "dep/patch"]
    },

    // ============ Helm ============
    {
      matchDatasources: ["helm"],
      ignoreDeprecated: true
    },
    {
      matchDatasources: ["helm"],
      matchUpdateTypes: ["major"],
      labels: ["renovate/helm", "dep/major"]
    },
    {
      matchDatasources: ["helm"],
      matchUpdateTypes: ["minor"],
      labels: ["renovate/helm", "dep/minor"]
    },
    {
      matchDatasources: ["helm"],
      matchUpdateTypes: ["patch"],
      labels: ["renovate/helm", "dep/patch"]
    },

    // ============ Image repos released by commit type ============
    {
      description: "Dependency bumps in image repos release a patch: release-please hides chore commits there. The dev container never reaches the image, so it stays chore",
      matchRepositories: [
        "anthony-spruyt/kata-tap-qdisc-fix",
        "anthony-spruyt/litellm-middleware",
        "anthony-spruyt/mcp-header-proxy",
        "anthony-spruyt/SunGather",
        "anthony-spruyt/traefik-api-key-auth"
      ],
      matchManagers: ["dockerfile", "gomod"],
      matchFileNames: ["!.devcontainer/**"],
      semanticCommitType: "fix",
      semanticCommitScope: "deps"
    },
    {
      description: "Runtime Python dependency bumps in image repos release a patch; dev groups never reach the image, so they stay chore",
      matchRepositories: ["anthony-spruyt/litellm-middleware", "anthony-spruyt/SunGather"],
      matchManagers: ["pep621"],
      matchDepTypes: ["project.dependencies", "project.optional-dependencies"],
      semanticCommitType: "fix",
      semanticCommitScope: "deps"
    },

    // ============ Managers ============
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-actions"]
    },
    {
      matchManagers: ["terraform"],
      addLabels: ["renovate/terraform"]
    },
    {
      matchManagers: ["devcontainer"],
      addLabels: ["renovate/devcontainer"]
    },
    {
      matchManagers: ["npm"],
      addLabels: ["renovate/npm"]
    },
    {
      matchManagers: ["nuget"],
      addLabels: ["renovate/nuget"]
    },
    {
      matchManagers: ["pep621", "pip_requirements"],
      addLabels: ["renovate/python"]
    },
    {
      matchManagers: ["pre-commit"],
      addLabels: ["renovate/pre-commit"]
    },
    {
      matchManagers: ["flux"],
      addLabels: ["renovate/flux"]
    },
    {
      description: "Enable digest pinning for Flux manager on OCI sources (Renovate >= v43.142.1 supports updating existing digest fields in OCIRepository spec/ref)",
      matchManagers: ["flux"],
      matchDatasources: ["docker", "oci"],
      pinDigests: true
    },
    {
      matchManagers: ["kubernetes"],
      addLabels: ["renovate/kubernetes"]
    },
    {
      matchManagers: ["helm-values"],
      addLabels: ["renovate/helm-values"]
    },

    // ============ Go toolchain ============
    {
      description: "Proactively bump Go toolchain version in go.mod to latest patch (default rangeStrategy only updates when a dependency requires it)",
      matchManagers: ["gomod"],
      matchDepTypes: ["golang"],
      rangeStrategy: "bump"
    },

    // ============ Custom regex ============
    {
      description: "Disable digest pinning for all custom regex managers (regex replacement cannot insert new digests, only update existing ones; built-in managers handle initial pinning)",
      matchManagers: ["custom.regex"],
      addLabels: ["renovate/script"],
      pinDigests: false
    },
    {
      matchManagers: ["custom.regex"],
      matchFileNames: ["**/flavor.yaml"],
      addLabels: ["renovate/megalinter-flavor"]
    },
    {
      matchManagers: ["custom.regex"],
      matchFileNames: ["**/metadata.yaml"],
      addLabels: ["renovate/upstream"]
    },
    {
      matchManagers: ["custom.regex"],
      matchFileNames: [".taskfiles/**"],
      addLabels: ["renovate/taskfile"]
    },
    {
      matchManagers: ["custom.regex"],
      matchFileNames: ["talos/**"],
      addLabels: ["renovate/talos"]
    },

    // ============ Prefixed release tags ============
    {
      description: "Azure CLI release tags are prefixed (azure-cli-2.90.0)",
      matchPackageNames: ["Azure/azure-cli"],
      matchDatasources: ["github-releases"],
      extractVersion: "^azure-cli-(?<version>.+)$"
    },

    // ============ n8n stable pins ============
    {
      // pinDigests must stay false, like the coder-stable pins: a custom
      // datasource returns null from getDigest, so any digest on these pins can
      // never be refreshed and warns "Could not determine new digest" on the
      // dashboard forever. Re-enabling it reintroduces that warning. Ref #397
      description: "n8n images resolve through custom.n8n-stable, tag-pinned without a digest",
      matchDatasources: ["custom.n8n-stable"],
      pinDigests: false,
      commitMessageTopic: "container image {{depName}}",
      commitMessageExtra: "to v{{{newVersion}}}",
      addLabels: ["renovate/image"]
    }
  ]
}
