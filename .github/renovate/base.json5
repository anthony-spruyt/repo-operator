{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "mergeConfidence:all-badges",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
    ":enablePreCommit"
  ],
  enabled: true,
  dependencyDashboardTitle: "Renovate Dashboard",
  suppressNotifications: ["prIgnoreNotification"],
  branchTopic: "{{{depNameSanitized}}}-{{{newVersion}}}",
  commitBodyTable: true,
  rebaseWhen: "conflicted",
  vulnerabilityAlerts: {
    enabled: true,
    addLabels: ["security"],
    // Renovate's default is null, which skips the 7-day supply-chain wait for "fix" releases
    minimumReleaseAge: "3 days"
  },
  osvVulnerabilityAlerts: true,
  hostRules: [
    {
      description: "Prevent GCR metadata token negotiation failures on hosted Renovate",
      matchHost: "gcr.io",
      hostType: "docker",
      abortOnError: false,
      abortIgnoreStatusCodes: [401, 403]
    },
    {
      description: "Prevent registry.k8s.io token negotiation failures on hosted Renovate",
      matchHost: "registry.k8s.io",
      hostType: "docker",
      abortOnError: false,
      abortIgnoreStatusCodes: [401, 403]
    }
  ]
}
