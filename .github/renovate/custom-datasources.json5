{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customDatasources: {
    "artifacthub-headlamp": {
      defaultRegistryUrlTemplate: "https://artifacthub.io/api/v1/packages/headlamp/{{packageName}}",
      format: "json",
      transformTemplates: [
        "{ \"releases\": [$map(available_versions, function($v) { { \"version\": $v.version } })] }"
      ]
    },
    // Coder publishes mainline and stable releases to the same tag namespace with
    // indistinguishable semver, so github-releases and helm both rank mainline
    // highest. The GitHub "latest release" marker is the authoritative stable
    // pointer — Coder's own install.sh resolves --stable by following it.
    // Emits a bare semver (no leading "v"); consumers that need the git tag
    // prepend it themselves.
    "coder-stable": {
      defaultRegistryUrlTemplate: "https://api.github.com/repos/coder/coder/releases/latest",
      format: "json",
      transformTemplates: [
        "{ \"releases\": [{ \"version\": $substring(tag_name, 1) }], \"sourceUrl\": \"https://github.com/coder/coder\", \"homepage\": \"https://coder.com\" }"
      ]
    },
    // n8n tags prereleases with plain semver, so the docker datasource ranks
    // them above stable. GitHub releases flag them explicitly, so filtering on
    // prerelease=false is enough — no tag/digest correlation needed.
    //
    // Docker Hub is deliberately not the source: it caps tag listings at 100
    // (~2 days), shorter than minimumReleaseAge, so the version being upgraded
    // *from* has always aged out. Custom datasources return null from
    // getDigest, so a pin carrying a digest could never refresh it and warned
    // "Could not determine new digest" on the dashboard forever. These pins
    // carry no digest (see the pinDigests: false rule) and the full release
    // history here keeps the current version resolvable. Ref #395, #397
    "n8n-stable": {
      defaultRegistryUrlTemplate: "https://api.github.com/repos/n8n-io/n8n/releases?per_page=100",
      format: "json",
      transformTemplates: [
        "{ \"releases\": [$[draft=false and prerelease=false and $count($match(tag_name, /^n8n@[0-9]+\\.[0-9]+\\.[0-9]+$/)) > 0].{ \"version\": $substring(tag_name, 4), \"releaseTimestamp\": published_at, \"changelogUrl\": html_url }], \"sourceUrl\": \"https://github.com/n8n-io/n8n\", \"homepage\": \"https://n8n.io\" }"
      ]
    }
  }
}
