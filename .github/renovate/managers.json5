{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  enabledManagers: [
    "custom.regex",
    "devcontainer",
    "dockerfile",
    "flux",
    "github-actions",
    "gomod",
    "helm-values",
    "kubernetes",
    "npm",
    "nuget",
    "pep621",
    "pip-compile",
    "pip_requirements",
    "pre-commit",
    "terraform"
  ],
  devcontainer: {
    managerFilePatterns: ["/\\.?devcontainer\\.json$/"]
  },
  flux: {
    managerFilePatterns: ["/(^|/)cluster/.+\\.ya?ml$/"]
  },
  "helm-values": {
    managerFilePatterns: [
      "/(^|/)cluster/.+/(values(\\.\\w+)?|values\\.ya?ml)$/",
      "/(^|/)cluster/.+/(release|helmrelease)\\.ya?ml$/"
    ]
  },
  kubernetes: {
    managerFilePatterns: [
      "/(^|/)cluster/.+\\.ya?ml$/",
      "/(^|/)talos/.+\\.ya?ml$/"
    ]
  },
  npm: {
    lockFileMaintenance: {
      enabled: true,
      minimumReleaseAge: "7 days",
      // Lock file maintenance has no release timestamp, so the default timestamp-required leaves renovate/stability-days pending
      minimumReleaseAgeBehaviour: "timestamp-optional"
    }
  },
  terraform: {
    managerFilePatterns: ["/\\.tf$/", "/\\.tfvars/"]
  }
}
