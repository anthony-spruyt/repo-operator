{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    // Shell scripts: VAR="repo:tag@digest". Must precede the plain-version
    // managers below, and stays separate from them because currentValue has to
    // be the tag alone — a whole-value capture yields "repo:tag@digest" as the
    // version, which no datasource can look up, so the dep silently never
    // updates until its pinned tag is garbage-collected and CI breaks.
    {
      customType: "regex",
      description: ["Annotated shell Docker image (depName first)."],
      managerFilePatterns: ["/\\.(sh|bash)$/"],
      matchStrings: [
        "depName=(?<depName>\\S+) datasource=docker\\n(?:export\\s+)?[A-Z_]+=\"[^:\"\\n]+:(?<currentValue>[^@\"\\n]+)(?:@(?<currentDigest>sha256:[^\"\\n]+))?\""
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker"
    },
    {
      customType: "regex",
      description: ["Annotated shell Docker image (datasource first)."],
      managerFilePatterns: ["/\\.(sh|bash)$/"],
      matchStrings: [
        "datasource=docker depName=(?<depName>\\S+)\\n(?:export\\s+)?[A-Z_]+=\"[^:\"\\n]+:(?<currentValue>[^@\"\\n]+)(?:@(?<currentDigest>sha256:[^\"\\n]+))?\""
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker"
    },
    // Shell scripts: VAR="version". currentValue excludes "/", ":" and "@" so a
    // Docker image ref falls through to the managers above; Renovate compiles
    // these with RE2, which has no lookahead, so the character class is the only
    // way to keep the two shapes apart.
    {
      customType: "regex",
      description: ["Annotated shell variable (depName first)."],
      managerFilePatterns: ["/\\.(sh|bash)$/"],
      matchStrings: [
        "depName=(?<depName>\\S+) datasource=(?<datasource>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\n(?:export\\s+)?[A-Z_]+=\"(?<currentValue>v?[^\"/:@\\s]+)\""
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      customType: "regex",
      description: ["Annotated shell variable (datasource first)."],
      managerFilePatterns: ["/\\.(sh|bash)$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\n(?:export\\s+)?[A-Z_]+=\"(?<currentValue>v?[^\"/:@\\s]+)\""
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    // YAML: version/key field. The space after the colon keeps bare URLs out.
    {
      customType: "regex",
      description: ["Annotated YAML field (depName first)."],
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*depName=(?<depName>\\S+)\\s+datasource=(?<datasource>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\n\\s*\\w+:[ \\t]+\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-tags{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      customType: "regex",
      description: ["Annotated YAML field (datasource first)."],
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\n\\s*\\w+:[ \\t]+\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-tags{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    // YAML: release download URL in a shell command. currentValue drops the
    // leading "v" so one dep can drive a URL carrying the version twice.
    {
      customType: "regex",
      description: ["Annotated release URL in a shell command (depName first)."],
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*depName=(?<depName>\\S+)\\s+datasource=(?<datasource>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\n[^\\n]*/releases/download/v?(?<currentValue>[0-9][^/\\s\"']*)/[^\\n]*"
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      extractVersionTemplate: "^v?(?<version>.+)$"
    },
    {
      customType: "regex",
      description: ["Annotated release URL in a shell command (datasource first)."],
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\n[^\\n]*/releases/download/v?(?<currentValue>[0-9][^/\\s\"']*)/[^\\n]*"
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      extractVersionTemplate: "^v?(?<version>.+)$"
    },
    // YAML: raw.githubusercontent.com URL, where the ref sits between the repo
    // and the file path. The "release URL" managers above only anchor on
    // "/releases/download/", and the "YAML field" managers require a "key: value"
    // line, so neither can reach a bare "- https://raw.githubusercontent.com/..."
    // list item such as a Talos extraManifests entry.
    {
      customType: "regex",
      description: ["Annotated raw.githubusercontent.com ref (depName first)."],
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*depName=(?<depName>\\S+)\\s+datasource=(?<datasource>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\n[^\\n]*raw\\.githubusercontent\\.com/[^/\\s]+/[^/\\s]+/(?<currentValue>[^/\\s]+)/[^\\n]*"
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-tags{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      customType: "regex",
      description: ["Annotated raw.githubusercontent.com ref (datasource first)."],
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\n[^\\n]*raw\\.githubusercontent\\.com/[^/\\s]+/[^/\\s]+/(?<currentValue>[^/\\s]+)/[^\\n]*"
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-tags{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    // YAML: kustomize images entry, where the tag and digest are separate keys.
    // The "Annotated Docker image" managers below cannot match this shape, since
    // they expect "repo:tag@digest" in a single quoted string, so without these
    // the generic "Annotated YAML field" managers claim the newTag line and leave
    // the digest unmanaged — the transformer then emits a fresh tag against a
    // stale digest, and the digest is what the runtime actually resolves.
    //
    // The annotation sits above the "- name:" line rather than above "newTag:".
    // That placement is load-bearing: the generic managers require a "key: value"
    // line directly beneath the comment, and "- name:" is not one, so they cannot
    // match a kustomize entry. Renovate compiles these with RE2, which has no
    // lookahead, so anchoring on the list item is how the overlap is avoided.
    {
      customType: "regex",
      description: ["Annotated kustomize images entry (depName first)."],
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*depName=(?<depName>\\S+)\\s+datasource=docker\\n\\s*-\\s*name:\\s*\\S+\\n\\s*newTag:\\s*\"?(?<currentValue>[^\"\\s]+)\"?(?:\\n\\s*digest:\\s*\"?(?<currentDigest>sha256:[a-f0-9]{64})\"?)?"
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker"
    },
    {
      customType: "regex",
      description: ["Annotated kustomize images entry (datasource first)."],
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=docker\\s+depName=(?<depName>\\S+)\\n\\s*-\\s*name:\\s*\\S+\\n\\s*newTag:\\s*\"?(?<currentValue>[^\"\\s]+)\"?(?:\\n\\s*digest:\\s*\"?(?<currentDigest>sha256:[a-f0-9]{64})\"?)?"
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker"
    },
    // Dockerfile: ARG VAR="version"
    {
      customType: "regex",
      description: ["Annotated Dockerfile ARG (depName first)."],
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        "#\\s*renovate:\\s*depName=(?<depName>\\S+)\\s+datasource=(?<datasource>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\nARG\\s+[A-Z_]+=(?:\"?)(?<currentValue>[^\"\\s]+)(?:\"?)"
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}npm{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      customType: "regex",
      description: ["Annotated Dockerfile ARG (datasource first)."],
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\nARG\\s+[A-Z_]+=(?:\"?)(?<currentValue>[^\"\\s]+)(?:\"?)"
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}npm{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    // JSON/JSONC: "key": "version". Reaches values the built-in managers do not
    // model, most notably a devcontainer feature's inner "version" — the
    // devcontainer manager updates the feature image ref and leaves the tool
    // version it installs pinned and drifting.
    {
      customType: "regex",
      description: ["Annotated JSON field (depName first)."],
      managerFilePatterns: ["/\\.json[5c]?$/"],
      matchStrings: [
        "//\\s*renovate:\\s*depName=(?<depName>\\S+)\\s+datasource=(?<datasource>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\n\\s*\"?[\\w.-]+\"?:\\s*\"(?<currentValue>[^\"\\n]+)\""
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      customType: "regex",
      description: ["Annotated JSON field (datasource first)."],
      managerFilePatterns: ["/\\.json[5c]?$/"],
      matchStrings: [
        "//\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\n\\s*\"?[\\w.-]+\"?:\\s*\"(?<currentValue>[^\"\\n]+)\""
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    // YAML: Docker image with optional digest
    {
      customType: "regex",
      description: ["Annotated Docker image (depName first)."],
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*depName=(?<depName>\\S+)\\s+datasource=docker\\n\\s*\\w+:\\s*\"[^:\\n]+:(?<currentValue>[^@\"\\n]+)(?:@(?<currentDigest>sha256:[^\"\\n]+))?\""
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker"
    },
    {
      customType: "regex",
      description: ["Annotated Docker image (datasource first)."],
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=docker\\s+depName=(?<depName>\\S+)\\n\\s*\\w+:\\s*\"[^:\\n]+:(?<currentValue>[^@\"\\n]+)(?:@(?<currentDigest>sha256:[^\"\\n]+))?\""
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker"
    },
    // Terraform: Docker image string with optional digest
    {
      customType: "regex",
      description: ["Annotated Terraform Docker image (depName first)."],
      managerFilePatterns: ["/\\.tf$/"],
      matchStrings: [
        "#\\s*renovate:\\s*depName=(?<depName>\\S+)\\s+datasource=docker\\n\\s*\\w+\\s*=\\s*\"[^:\\n]+:(?<currentValue>[^@\"\\n]+)(?:@(?<currentDigest>sha256:[^\"\\n]+))?\""
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker"
    },
    {
      customType: "regex",
      description: ["Annotated Terraform Docker image (datasource first)."],
      managerFilePatterns: ["/\\.tf$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=docker\\s+depName=(?<depName>\\S+)\\n\\s*\\w+\\s*=\\s*\"[^:\\n]+:(?<currentValue>[^@\"\\n]+)(?:@(?<currentDigest>sha256:[^\"\\n]+))?\""
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker"
    }
  ]
}
